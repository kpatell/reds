# Supabase — get these from your project's API settings at supabase.com/dashboard
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Comma-separated list of emails that can toggle the in-game DEV button (local/staging only)
# VITE_DEV_EMAILS=dev@example.com,another@example.com
